# Non-secret env scaffolding, seeded by bootstrap.sh into ~/.config/dotfiles.env
# Machine-local secrets and host settings go in ~/.config/dotfiles.env (never committed):
#   export NOTES_SYNC_HOST=...
#   export TOGGL_API_TOKEN=...
#
# Host gates (scripts/install-launchagents.sh):
#   export NOTES_SYNC_HOST=1     # nightly vault-sync LaunchAgent (the git-actor Mac)
#   export TAILSCALE_WATCHDOG=1  # keep Tailscale running every 5 min (headless hosts)

# Notes root
export NOTES="$HOME/Documents/notes/"

# Todo root
export TODO="$HOME/Documents/notes/todo/"
